---

---

<section id="projects" class="projects">
    <div class="section-header">
        <h2>Selected Works</h2>
        <div class="header-line"></div>
    </div>

    <div class="project-list">
        <!-- Project 1 -->
        <article class="project-card">
            <div class="project-content">
                <div class="project-header">
                    <h3>Neural Network Visualizer</h3>
                    <a href="#" class="repo-link" aria-label="View Source">
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="20"
                            height="20"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            ><path
                                d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"
                            ></path></svg
                        >
                    </a>
                </div>

                <div class="process">
                    <h4>The Challenge</h4>
                    <p>
                        Understanding backpropagation is intuitive for humans
                        but difficult to visualize in real-time. The goal was to
                        create a tool that renders network weights dynamically
                        without freezing the browser thread.
                    </p>

                    <h4>The Process</h4>
                    <p>
                        I utilized WebGL for rendering the node connections,
                        allowing for 10,000+ interactive elements60fps. The
                        state management logic was offloaded to a Web Worker to
                        ensure UI responsiveness.
                    </p>
                </div>

                <ul class="tech-stack">
                    <li>TypeScript</li>
                    <li>WebGL</li>
                    <li>Rust (WASM)</li>
                </ul>
            </div>

            <div class="project-visual">
                <div class="placeholder-image">
                    <span>Project Screenshot</span>
                </div>
            </div>
        </article>

        <!-- Project 2 -->
        <article class="project-card reverse">
            <div class="project-content">
                <div class="project-header">
                    <h3>EcoTrack Analytics</h3>
                    <a href="#" class="repo-link" aria-label="View Source">
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="20"
                            height="20"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            ><path
                                d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"
                            ></path></svg
                        >
                    </a>
                </div>

                <div class="process">
                    <h4>The Challenge</h4>
                    <p>
                        Aggregating sensor data from disparate sources into a
                        unified dashboard for municipal energy tracking. Data
                        consistency and real-time alerts were critical.
                    </p>

                    <h4>The Process</h4>
                    <p>
                        Designed a microservices architecture using Go.
                        Implemented a time-series database (TimescaleDB) for
                        efficient data storage and retrieval. Created a custom
                        React dashboard with D3.js visualizations.
                    </p>
                </div>

                <ul class="tech-stack">
                    <li>Go</li>
                    <li>TimescaleDB</li>
                    <li>D3.js</li>
                </ul>
            </div>

            <div class="project-visual">
                <div class="placeholder-image">
                    <span>Dashboard UI</span>
                </div>
            </div>
        </article>
    </div>
</section>

<style>
    .projects {
        padding: var(--spacing-xl) 0;
    }

    .section-header {
        display: flex;
        align-items: center;
        gap: var(--spacing-md);
        margin-bottom: var(--spacing-xl);
    }

    .header-line {
        height: 1px;
        flex: 1;
        background: var(--color-border);
    }

    .project-list {
        display: flex;
        flex-direction: column;
        gap: var(--spacing-xl);
    }

    .project-card {
        display: grid;
        grid-template-columns: 1.2fr 0.8fr;
        gap: var(--spacing-lg);
        background: rgba(255, 255, 255, 0.02);
        border: 1px solid var(--color-border);
        padding: var(--spacing-lg);
    }

    .project-card.reverse {
        grid-template-columns: 0.8fr 1.2fr;
    }

    .project-card.reverse .project-content {
        order: 2;
    }
    .project-card.reverse .project-visual {
        order: 1;
    }

    .project-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: var(--spacing-md);
    }

    .project-header h3 {
        font-size: 1.5rem;
        color: var(--color-text-main);
    }

    .repo-link {
        color: var(--color-text-muted);
        transition: color 0.2s;
    }

    .repo-link:hover {
        color: var(--color-accent);
    }

    .process h4 {
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--color-accent);
        margin-bottom: var(--spacing-sm);
        margin-top: var(--spacing-md);
    }

    .process h4:first-child {
        margin-top: 0;
    }

    .process p {
        font-size: 0.95rem;
        color: var(--color-text-muted);
        line-height: 1.7;
        margin-bottom: var(--spacing-md);
    }

    .tech-stack {
        display: flex;
        gap: var(--spacing-md);
        margin-top: var(--spacing-lg);
        font-family: var(--font-heading);
        font-size: 0.85rem;
        color: var(--color-text-main);
    }

    .project-visual {
        position: relative;
        min-height: 300px;
        background: var(--color-bg-medium);
        border: 1px solid var(--color-border);
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
    }

    .project-visual::before {
        content: "";
        position: absolute;
        top: 10px;
        left: 10px;
        right: 10px;
        bottom: 10px;
        border: 1px dashed var(--color-text-muted);
        opacity: 0.3;
    }

    .placeholder-image {
        color: var(--color-text-muted);
        font-family: var(--font-heading);
        letter-spacing: 0.1em;
        text-transform: uppercase;
        font-size: 0.9rem;
    }

    @media (max-width: 900px) {
        .project-card,
        .project-card.reverse {
            grid-template-columns: 1fr;
        }

        .project-card.reverse .project-content {
            order: 1;
        }
        .project-card.reverse .project-visual {
            order: 2;
        }
    }
</style>
