---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";

export async function getStaticPaths({ paginate }) {
    const projects = (await getCollection("projects")).sort(
        (a, b) => a.data.order - b.data.order,
    );
    return paginate(projects, { pageSize: 5 });
}

const { page } = Astro.props;
---

<Layout title="All Projects | Nicolás Rojas">
    <div class="projects-page">
        <header class="page-header">
            <h1>All Projects</h1>
            <p>A comprehensive list of my technical work and experiments.</p>
        </header>

        <div class="project-list">
            {
                page.data.map((project, index) => (
                    <article
                        class={`project-card ${index % 2 !== 0 ? "reverse" : ""}`}
                    >
                        <div class="project-content">
                            <div class="project-header">
                                <h3>{project.data.title}</h3>
                                <a
                                    href={project.data.repoLink}
                                    class="repo-link"
                                    aria-label="View Source"
                                    target="_blank"
                                    rel="noopener noreferrer"
                                >
                                    <svg
                                        xmlns="http://www.w3.org/2000/svg"
                                        width="20"
                                        height="20"
                                        viewBox="0 0 24 24"
                                        fill="none"
                                        stroke="currentColor"
                                        stroke-width="2"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                    >
                                        <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22" />
                                    </svg>
                                </a>
                            </div>

                            <div class="process">
                                <h4>The Challenge</h4>
                                <p>{project.data.challenge}</p>

                                <h4>The Process</h4>
                                <p>{project.data.process}</p>
                            </div>

                            <ul class="tech-stack">
                                {project.data.techStack.map((tech) => (
                                    <li>{tech}</li>
                                ))}
                            </ul>
                        </div>

                        <div class="project-visual">
                            <div class="placeholder-image">
                                <span>{project.data.title} UI</span>
                            </div>
                        </div>
                    </article>
                ))
            }
        </div>

        {
            page.lastPage > 1 && (
                <nav class="pagination">
                    {page.url.prev ? (
                        <a href={page.url.prev} class="btn btn-secondary">
                            Previous
                        </a>
                    ) : (
                        <span />
                    )}
                    <span class="page-info">
                        Page {page.currentPage} of {page.lastPage}
                    </span>
                    {page.url.next ? (
                        <a href={page.url.next} class="btn btn-secondary">
                            Next
                        </a>
                    ) : (
                        <span />
                    )}
                </nav>
            )
        }
    </div>
</Layout>

<style>
    .projects-page {
        padding-top: var(--spacing-xl);
    }

    .page-header {
        margin-bottom: var(--spacing-xl);
        text-align: center;
    }

    h1 {
        font-size: 3rem;
        margin-bottom: var(--spacing-md);
    }

    .page-header p {
        color: var(--color-text-muted);
        font-size: 1.1rem;
        max-width: 600px;
        margin: 0 auto;
    }

    .project-list {
        display: flex;
        flex-direction: column;
        gap: var(--spacing-xl);
    }

    .project-card {
        display: grid;
        grid-template-columns: 1.2fr 0.8fr;
        gap: var(--spacing-lg);
        background: rgba(255, 255, 255, 0.02);
        border: 1px solid var(--color-border);
        padding: var(--spacing-lg);
    }

    .project-card.reverse {
        grid-template-columns: 0.8fr 1.2fr;
    }

    .project-card.reverse .project-content {
        order: 2;
    }
    .project-card.reverse .project-visual {
        order: 1;
    }

    .project-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: var(--spacing-md);
    }

    .project-header h3 {
        font-size: 1.5rem;
        color: var(--color-text-main);
    }

    .repo-link {
        color: var(--color-text-muted);
        transition: color 0.2s;
    }

    .repo-link:hover {
        color: var(--color-accent);
    }

    .process h4 {
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--color-accent);
        margin-bottom: var(--spacing-sm);
        margin-top: var(--spacing-md);
    }

    .process h4:first-child {
        margin-top: 0;
    }

    .process p {
        font-size: 0.95rem;
        color: var(--color-text-muted);
        line-height: 1.7;
        margin-bottom: var(--spacing-md);
    }

    .tech-stack {
        display: flex;
        gap: var(--spacing-md);
        margin-top: var(--spacing-lg);
        font-family: var(--font-heading);
        font-size: 0.85rem;
        color: var(--color-text-main);
    }

    .project-visual {
        position: relative;
        min-height: 300px;
        background: var(--color-bg-medium);
        border: 1px solid var(--color-border);
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
    }

    .project-visual::before {
        content: "";
        position: absolute;
        top: 10px;
        left: 10px;
        right: 10px;
        bottom: 10px;
        border: 1px dashed var(--color-text-muted);
        opacity: 0.3;
    }

    .placeholder-image {
        color: var(--color-text-muted);
        font-family: var(--font-heading);
        letter-spacing: 0.1em;
        text-transform: uppercase;
        font-size: 0.9rem;
    }

    /* Pagination */
    .pagination {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: var(--spacing-lg);
        margin-top: var(--spacing-xl);
        padding-top: var(--spacing-lg);
        border-top: 1px solid var(--color-border);
    }

    .page-info {
        color: var(--color-text-muted);
        font-size: 0.9rem;
    }

    .btn {
        display: inline-block;
        padding: 0.5rem 1rem;
        font-weight: 500;
        border-radius: 4px;
        transition: all 0.3s ease;
        text-decoration: none;
    }

    .btn-secondary {
        border: 1px solid var(--color-text-muted);
        color: var(--color-text-main);
    }

    .btn-secondary:hover {
        border-color: var(--color-accent);
        color: var(--color-accent);
    }

    @media (max-width: 900px) {
        .project-card,
        .project-card.reverse {
            grid-template-columns: 1fr;
        }

        .project-card.reverse .project-content {
            order: 1;
        }
        .project-card.reverse .project-visual {
            order: 2;
        }
    }
</style>
