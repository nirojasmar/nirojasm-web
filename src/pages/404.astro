---
import Layout from "../layouts/Layout.astro";
---

<Layout title="404: Not Found">
    <div class="error-page">
        <div class="glitch-container">
            <h1 class="glitch" data-text="404">404</h1>
        </div>
        <h2>Page Not Found</h2>
        <p>
            Oops! The page you're looking for doesn't exist.
            Maybe I moved it or deleted it.
            Try searching for something else 🤔.
        </p>

        <a href="/" class="btn btn-primary">Return Home</a>

        <div class="broken-shapes">
            <div class="shape shape-1"></div>
            <div class="shape shape-2"></div>
            <div class="shape shape-3"></div>
        </div>
    </div>
</Layout>

<style>
    .error-page {
        min-height: 70vh;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        text-align: center;
        position: relative;
    }

    h1 {
        font-size: clamp(6rem, 15vw, 10rem);
        line-height: 1;
        margin: 0;
        color: var(--color-accent);
        opacity: 0.9;
        font-family: var(--font-heading);
    }

    h2 {
        font-size: 2rem;
        margin-bottom: var(--spacing-sm);
        margin-top: var(--spacing-lg);
    }

    p {
        color: var(--color-text-muted);
        max-width: 400px;
        margin-bottom: var(--spacing-xl);
    }

    .btn {
        display: inline-block;
        padding: 0.75rem 2rem;
        background-color: var(--color-accent);
        color: var(--color-bg-deep);
        font-weight: 600;
        border-radius: 4px;
        transition:
            transform 0.2s,
            background-color 0.2s;
    }

    .btn:hover {
        transform: translateY(-2px);
        background-color: var(--color-accent-hover);
    }

    /* Glitch Effect */
    .glitch {
        position: relative;
    }

    .glitch::before,
    .glitch::after {
        content: attr(data-text);
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: var(--color-bg-deep);
    }

    .glitch::before {
        left: 2px;
        text-shadow: -1px 0 red;
        clip: rect(24px, 550px, 90px, 0);
        animation: glitch-anim-2 3s infinite linear alternate-reverse;
    }

    .glitch::after {
        left: -2px;
        text-shadow: -1px 0 blue;
        clip: rect(85px, 550px, 140px, 0);
        animation: glitch-anim 2.5s infinite linear alternate-reverse;
    }

    @keyframes glitch-anim {
        0% {
            clip: rect(11px, 9999px, 39px, 0);
        }
        20% {
            clip: rect(74px, 9999px, 63px, 0);
        }
        40% {
            clip: rect(31px, 9999px, 86px, 0);
        }
        60% {
            clip: rect(81px, 9999px, 16px, 0);
        }
        80% {
            clip: rect(2px, 9999px, 92px, 0);
        }
        100% {
            clip: rect(56px, 9999px, 44px, 0);
        }
    }

    @keyframes glitch-anim-2 {
        0% {
            clip: rect(65px, 9999px, 100px, 0);
        }
        20% {
            clip: rect(15px, 9999px, 3px, 0);
        }
        40% {
            clip: rect(98px, 9999px, 21px, 0);
        }
        60% {
            clip: rect(5px, 9999px, 73px, 0);
        }
        80% {
            clip: rect(44px, 9999px, 5px, 0);
        }
        100% {
            clip: rect(83px, 9999px, 13px, 0);
        }
    }

    /* Decorative Broken Shapes */
    .broken-shapes {
        position: absolute;
        width: 100%;
        height: 100%;
        top: 0;
        left: 0;
        pointer-events: none;
        z-index: -1;
    }

    .shape {
        position: absolute;
        opacity: 0.1;
        border: 1px solid var(--color-accent);
    }

    .shape-1 {
        top: 20%;
        left: 10%;
        width: 100px;
        height: 100px;
        transform: rotate(15deg) skew(10deg);
        border-right: none;
    }

    .shape-2 {
        bottom: 15%;
        right: 15%;
        width: 150px;
        height: 150px;
        transform: rotate(-10deg);
        border-top: none;
    }

    .shape-3 {
        top: 40%;
        right: 30%;
        width: 50px;
        height: 50px;
        transform: rotate(45deg);
        background: var(--color-bg-light);
        opacity: 0.05;
    }
</style>
