---
import { getPosts, getPost } from "../../../lib/sanity";
import Layout from "../../../layouts/Layout.astro";
import { marked } from "marked";

export async function getStaticPaths() {
    const supportedLangs = ["es"];
    const paths = [];

    for (const lang of supportedLangs) {
        const posts = await getPosts(lang);
        const localizedPaths = posts.map((post) => ({
            params: { lang, slug: post.slug.current },
        }));
        paths.push(...localizedPaths);
    }
    return paths;
}

const { lang, slug } = Astro.params;
const post = await getPost(slug, lang);

if (!post) {
    return Astro.redirect("/404");
}

const content = marked.parse(post.content);
---

<Layout title={`${post.title} | Nicolás Rojas`}>
    <article class="post-container">
        <header class="post-header">
            <div class="meta">
                <time class="date"
                    >{
                        new Date(post.pubDate).toLocaleDateString(
                            lang === "es" ? "es-ES" : "en-US",
                            {
                                year: "numeric",
                                month: "long",
                                day: "numeric",
                            },
                        )
                    }</time
                >
                <div class="tags">
                    {post.tags && post.tags.map((tag) => <span>#{tag}</span>)}
                </div>
            </div>
            <h1>{post.title}</h1>
            <p class="author">By {post.author}</p>
        </header>

        <div class="post-content" set:html={content} />

        <footer class="post-footer">
            <a href={`/${lang}/blog`} class="back-link">&larr; Back to Blog</a>
        </footer>
    </article>
</Layout>

<style>
    .post-container {
        max-width: 900px;
        margin: var(--spacing-xl) auto;
        margin-bottom: var(--spacing-lg);
    }

    .post-header {
        margin-bottom: var(--spacing-lg);
        text-align: center;
        border-bottom: 1px solid var(--color-border);
        padding-bottom: var(--spacing-md);
    }

    .meta {
        display: flex;
        justify-content: center;
        gap: var(--spacing-md);
        margin-bottom: var(--spacing-sm);
        font-size: 0.9rem;
        color: var(--color-text-muted);
    }

    .date {
        color: var(--color-accent);
    }

    h1 {
        font-size: clamp(2rem, 5vw, 3rem);
        line-height: 1.1;
        margin-bottom: var(--spacing-md);
    }

    .author {
        font-style: italic;
        color: var(--color-text-muted);
    }

    /* Markdown Content Styling */
    .post-content {
        line-height: 1.8;
        font-size: 1.1rem;
    }

    .post-content :global(h2) {
        font-size: 1.8rem;
        margin-top: var(--spacing-xl);
        margin-bottom: var(--spacing-md);
        color: var(--color-text-main);
    }

    .post-content :global(h3) {
        font-size: 1.4rem;
        margin-top: var(--spacing-lg);
        margin-bottom: var(--spacing-sm);
    }

    .post-content :global(p) {
        margin-bottom: var(--spacing-md);
        color: #d1d5db; /* Light gray */
    }

    .post-content :global(ul),
    .post-content :global(ol) {
        margin-bottom: var(--spacing-md);
        padding-left: var(--spacing-lg);
    }

    .post-content :global(li) {
        margin-bottom: var(--spacing-sm);
    }

    .post-content :global(blockquote) {
        border-left: 4px solid var(--color-accent);
        padding-left: var(--spacing-md);
        margin: var(--spacing-lg) 0;
        font-style: italic;
        color: var(--color-text-muted);
    }

    .post-content :global(code) {
        background: rgba(255, 255, 255, 0.1);
        padding: 0.2em 0.4em;
        border-radius: 4px;
        font-size: 0.9em;
        font-family: monospace;
    }

    .post-content :global(pre) {
        background: #05100a;
        padding: var(--spacing-md);
        border-radius: 8px;
        overflow-x: auto;
        margin-bottom: var(--spacing-lg);
        border: 1px solid var(--color-border);
    }

    .post-content :global(pre code) {
        background: none;
        padding: 0;
    }

    .post-footer {
        margin-top: var(--spacing-xl);
        padding-top: var(--spacing-lg);
        border-top: 1px solid var(--color-border);
    }

    .back-link {
        color: var(--color-accent);
        font-weight: 500;
    }
    .back-link:hover {
        text-decoration: underline;
    }
</style>
