---
import { getPosts, urlFor } from "../../../lib/sanity";
import Layout from "../../../layouts/Layout.astro";
import { useTranslations } from "../../../i18n/utils";

export async function getStaticPaths({ paginate }) {
    const supportedLangs = ["es"];
    const paths = [];

    for (const lang of supportedLangs) {
        const posts = await getPosts(lang);
        const paginated = paginate(posts, { pageSize: 10, params: { lang } });
        paths.push(...paginated);
    }
    return paths;
}

const { lang } = Astro.params;
const { page } = Astro.props;
const t = useTranslations(lang);
---

<Layout title={`${t("blog.title")} | Nicolás Rojas`}>
    <div class="blog-page">
        <header class="page-header">
            <h1>{t("blog.title")}</h1>
            <p>
                {
                    lang === "es"
                        ? "Exploraciones en arquitectura de software, diseño y rendimiento."
                        : "Explorations in software architecture, design, and performance."
                }
            </p>
        </header>

        <div class="blog-grid">
            {
                page.data.map((post) => (
                    <article class="blog-card">
                        <div class="date">
                            {new Date(post.pubDate).toLocaleDateString(
                                lang === "es" ? "es-ES" : "en-US",
                                {
                                    year: "numeric",
                                    month: "short",
                                    day: "numeric",
                                },
                            )}
                        </div>
                        {post.mainImage && (
                            <div class="post-image">
                                <img
                                    src={urlFor(post.mainImage)
                                        .width(800)
                                        .height(400)
                                        .url()}
                                    alt={post.title}
                                />
                            </div>
                        )}
                        <h2>
                            <a href={`/${lang}/blog/${post.slug.current}`}>
                                {post.title}
                            </a>
                        </h2>
                        <p>{post.description}</p>
                        <div class="card-footer">
                            <div class="tags">
                                {post.tags &&
                                    post.tags.map((tag) => <span>#{tag}</span>)}
                            </div>
                            <a
                                href={`/${lang}/blog/${post.slug.current}`}
                                class="read-more"
                            >
                                Read Article &rarr;
                            </a>
                        </div>
                    </article>
                ))
            }
        </div>

        {
            page.lastPage > 1 && (
                <nav class="pagination">
                    {page.url.prev ? (
                        <a href={page.url.prev} class="btn btn-secondary">
                            Previous
                        </a>
                    ) : (
                        <span />
                    )}
                    <span class="page-info">
                        Page {page.currentPage} of {page.lastPage}
                    </span>
                    {page.url.next ? (
                        <a href={page.url.next} class="btn btn-secondary">
                            Next
                        </a>
                    ) : (
                        <span />
                    )}
                </nav>
            )
        }
    </div>
</Layout>

<style>
    .blog-page {
        padding-top: var(--spacing-xl);
    }

    .page-header {
        margin-bottom: var(--spacing-xl);
        text-align: center;
    }

    h1 {
        font-size: 3rem;
        margin-bottom: var(--spacing-md);
    }

    .page-header p {
        color: var(--color-text-muted);
        font-size: 1.1rem;
        max-width: 600px;
        margin: 0 auto;
    }

    .blog-grid {
        display: grid;
        gap: var(--spacing-lg);
        max-width: 800px;
        margin: 0 auto;
    }

    .blog-card {
        background: rgba(255, 255, 255, 0.02);
        border: 1px solid var(--color-border);
        padding: var(--spacing-lg);
        transition:
            transform 0.2s,
            border-color 0.2s;
    }

    .blog-card:hover {
        border-color: var(--color-accent);
        transform: translateX(4px);
    }

    .date {
        font-family: var(--font-heading);
        color: var(--color-accent);
        font-size: 0.9rem;
        margin-bottom: var(--spacing-sm);
    }

    .blog-card h2 {
        font-size: 1.5rem;
        margin-bottom: var(--spacing-xs);
    }

    .blog-card p {
        color: var(--color-text-muted);
        margin-bottom: var(--spacing-sm);
    }

    .post-image {
        margin-bottom: var(--spacing-md);
        border-radius: 4px;
        overflow: hidden;
        /* Center content if reduced width */
        display: flex;
        justify-content: center;
    }

    .post-image img {
        width: 100%; /* If using width on container, or 90% here */
        max-width: 90%; /* Reduce max width to 90% of container */
        height: auto;
        display: block;
        object-fit: cover;
        margin: 0 auto; /* Center the image */
        border-radius: 4px; /* Ensure rounded corners on the image itself */
    }

    .card-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .tags {
        display: flex;
        gap: var(--spacing-sm);
        font-size: 0.85rem;
        color: var(--color-text-muted);
        opacity: 0.7;
    }

    .read-more {
        color: var(--color-accent);
        font-weight: 500;
    }

    .read-more:hover {
        text-decoration: underline;
    }

    /* Pagination */
    .pagination {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: var(--spacing-lg);
        margin-top: var(--spacing-xl);
        padding-top: var(--spacing-lg);
        border-top: 1px solid var(--color-border);
    }

    .page-info {
        color: var(--color-text-muted);
        font-size: 0.9rem;
    }

    .btn {
        display: inline-block;
        padding: 0.5rem 1rem;
        font-weight: 500;
        border-radius: 4px;
        transition: all 0.3s ease;
        text-decoration: none;
    }

    .btn-secondary {
        border: 1px solid var(--color-text-muted);
        color: var(--color-text-main);
    }

    .btn-secondary:hover {
        border-color: var(--color-accent);
        color: var(--color-accent);
    }
</style>
