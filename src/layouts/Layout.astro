---
import "../styles/global.css";

interface Props {
    title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="description" content="Portfolio" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Outfit:wght@400;700&display=swap"
            rel="stylesheet"
        />
        <meta name="generator" content={Astro.generator} />
        <title>{title}</title>
    </head>
    <body>
        <div class="geometric-bg"></div>
        <main>
            <slot />
        </main>
    </body>
</html>

<style>
    .geometric-bg {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: -1;
        background: radial-gradient(
            circle at 10% 20%,
            var(--color-bg-medium) 0%,
            var(--color-bg-deep) 60%
        );
        overflow: hidden;
    }

    .geometric-bg::before,
    .geometric-bg::after {
        content: "";
        position: absolute;
        display: block;
        opacity: 0.1;
    }

    /* Large Triangle top right */
    .geometric-bg::before {
        top: -10%;
        right: -10%;
        width: 60vw;
        height: 60vw;
        background: var(--color-bg-light);
        transform: rotate(45deg);
        clip-path: polygon(0 0, 100% 0, 100% 100%);
    }

    /* Rectangle overlap bottom left */
    .geometric-bg::after {
        bottom: 10%;
        left: -5%;
        width: 40vw;
        height: 30vh;
        background: var(--color-accent);
        opacity: 0.03;
        transform: skewY(-10deg);
    }

    main {
        position: relative;
        z-index: 1;
        max-width: 1200px;
        margin: 0 auto;
        padding: var(--spacing-lg);
    }
</style>
